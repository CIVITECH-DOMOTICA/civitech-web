# Configuración del servidor y base de datos
NODE_ENV=development

# ⚠️  SEGURIDAD: La API key de OpenAI NO se pone aquí.
# El chatbot usa un proxy n8n — la key se configura en n8n, nunca en el frontend.

# Webhook n8n — Chatbot proxy (OpenAI se llama desde n8n, no desde el browser)
CHATBOT_WEBHOOK_URL=https://n8n.civitech.es/webhook/civitech-chatbot

# Webhook n8n — Leads del formulario de contacto
N8N_LEAD_WEBHOOK_URL=https://n8n.civitech.es/webhook/civitech-lead

# EmailJS — Notificaciones de contacto desde el chatbot
EMAILJS_PUBLIC_KEY=tu-clave-publica-de-emailjs
EMAILJS_SERVICE_ID=tu-id-de-servicio
EMAILJS_TEMPLATE_ID=tu-id-de-plantilla
